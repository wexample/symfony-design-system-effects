{
  "name": "wexample/symfony-design-system-effects",
  "version": "3.0.4",
  "type": "library",
  "license": "MIT",
  "description": "Effects of the wexample brand for the design system: generated avatars (wexies-2020) first",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyDesignSystemEffects\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyDesignSystemEffects\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=18.0.2",
    "wexample/symfony-design-system": ">=40.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}